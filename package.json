{
  "name": "framejam",
  "version": "0.1.1",
  "description": "Review videos from your coding agent: pick a style, then point at the frame and say what to change. Works with Hyperframes, Remotion and any other video tool, over MCP.",
  "keywords": [
    "mcp",
    "mcp-server",
    "video",
    "review",
    "agent",
    "hyperframes",
    "remotion",
    "gsap",
    "cursor",
    "claude-code",
    "codex"
  ],
  "homepage": "https://www.framejam.ai",
  "bugs": {
    "url": "https://github.com/moritzkremb/framejam/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moritzkremb/framejam.git"
  },
  "license": "MIT",
  "author": "Moritz Kremb",
  "type": "module",
  "bin": {
    "framejam": "dist/server/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "presets",
    "!presets/*/preview.mp4",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"tsx watch src/server/cli.ts\" \"vite\"",
    "build": "tsc -b && vite build && tsup",
    "start": "node dist/server/cli.js",
    "typecheck": "tsc -b",
    "lint": "oxlint src tests scripts",
    "test": "vitest run",
    "render:presets": "tsx scripts/render-presets.ts",
    "e2e": "tsx scripts/e2e.ts",
    "sync:rule": "tsx scripts/sync-rule.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@hyperframes/core": "^0.8.104",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "gsap": "^3.15.0",
    "hono": "^4.13.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "cn": "^0.4.0",
    "concurrently": "^10.0.5",
    "lucide-react": "^1.49.0",
    "oxlint": "^1.81.0",
    "puppeteer-core": "^24.43.1",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "sonner": "^2.0.8",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
